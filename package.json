{
  "name": "phosphor-icons-semantic-search-mcp",
  "version": "0.1.0",
  "description": "MCP server for semantic search over Phosphor icons",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "phosphor-icon-search": "./dist/index.js"
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "export-catalog": "tsx build/export_catalog.ts",
    "build:descriptions": ".venv/bin/python build/01_generate_descriptions.py",
    "build:embeddings": ".venv/bin/python build/02_create_embeddings.py",
    "build:data": "npm run export-catalog && npm run build:descriptions && npm run build:embeddings",
    "build:full": "npm run build && npm run build:data && npm run validate:index",
    "validate:index": "tsx build/03_validate_index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@phosphor-icons/core": "^2.1.1",
    "@xenova/transformers": "^2.17.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
